# Database
DATABASE_URL=postgresql://helpbee_user:helpbee_password@localhost:5432/helpbee

# Redis
REDIS_URL=redis://localhost:6379

# API Server
API_PORT=3001
API_HOST=0.0.0.0
NODE_ENV=development

# AI Server
AI_PORT=8000
AI_HOST=0.0.0.0

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# AWS S3 / Image Storage (인프라 ap-northeast-2 Seoul)
AWS_REGION=ap-northeast-2
# 로컬: SSO/aws-vault 권장 · 배포(beta): EC2 instance profile — 장기키를 서버 .env에 절대 넣지 않는다.
# (docker-compose.beta.yml은 이 두 키를 컨테이너에 주입하지 않음. 아래는 로컬 더미.)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
S3_IMAGES_BUCKET=helpbee-images-dev

# Authentication (apps/api config/env.ts가 길이 fail-fast + 플레이스홀더/중복 검증)
JWT_SECRET=dev_only_secret_jwt_0000000000000000000000000000000000000000000000000  # >=64 chars, placeholder 금지
REFRESH_TOKEN_PEPPER=dev_only_refresh_pepper_00000000000000  # >=32 chars (HMAC-SHA256, argon2 아님). JWT_SECRET과 달라야 함
JWT_ACCESS_TTL_SEC=900          # access 15분
JWT_REFRESH_TTL_SEC=604800      # refresh 7일
JWT_ADMIN_AUDIENCE=helpbee-admin  # admin 토큰 별도 audience(blast radius 축소)
# 로그인 계정 보호(argon2 이전 게이트): email+ip 복합키
AUTH_LOGIN_MAX_FAILS=10         # 초과 시 AUTH_ACCOUNT_LOCKED(429)
AUTH_LOCKOUT_WINDOW_SEC=900     # 잠금/슬라이딩 윈도 15분
# CORS allowlist(콤마구분, 와일드카드 * 금지). 비우면 CORS 미허용.
CORS_ALLOWLIST=http://localhost:3000,http://localhost:3001

# AI service (apps/api -> apps/ai)
AI_BASE_URL=http://localhost:8000
AI_INTERNAL_HMAC_SECRET=dev_only_internal_hmac_secret_00000000  # >=32 chars (D10 내부 인증). JWT_SECRET과 달라야 함

# Subscriptions webhook (결제 PG, §11.4). MVP 기본 비활성(inert).
SUBSCRIPTION_WEBHOOK_ENABLED=false
# WEBHOOK_HMAC_SECRET=set_in_secrets_manager_min_32_chars   # 활성화 시 필수(미설정 시 WEBHOOK_DISABLED)

# 관측성
# SENTRY_DSN=https://...@sentry.io/...   # 미설정 시 비활성(로컬)
# apps/ai가 image_url을 fetch할 때 허용할 host(SSRF allowlist, 쉼표구분, 서브도메인 포함)
IMAGE_ALLOWLIST_HOSTS=s3.ap-northeast-2.amazonaws.com,cdn.helpbee.kr
IMAGE_FETCH_ALLOW_HTTP=false

# Email 인증 발송 (apps/api, P1-4). provider=console(로그만) / resend(Resend REST API).
EMAIL_PROVIDER=console                       # 로컬 기본. resend로 바꾸면 RESEND_API_KEY 필수(env.ts refine)
# RESEND_API_KEY=re_...                       # EMAIL_PROVIDER=resend일 때만 필요(빈 문자열=미설정 취급)
EMAIL_FROM=HelpBee <onboarding@resend.dev>   # 미검증 도메인은 Resend 계정 소유자 주소로만 발송 가능
EMAIL_VERIFY_BASE_URL=http://localhost:3001  # 인증 링크 base(운영은 https://api.helpbee.kr)

# Email (레거시 SMTP 알림용 — 인증 발송에는 미사용)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_email_password

# Service URLs
WEB_URL=http://localhost:3000
API_URL=http://localhost:3001
AI_URL=http://localhost:8000

# Feature Flags
ENABLE_AI_ANALYSIS=true
ENABLE_EMAIL_NOTIFICATIONS=false
