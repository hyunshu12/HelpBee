# Database
DATABASE_URL=postgresql://helpbee_user:helpbee_password@localhost:5432/helpbee

# Redis
REDIS_URL=redis://localhost:6379

# API Server
API_PORT=3001
API_HOST=0.0.0.0
NODE_ENV=development

# AI Server
AI_PORT=8000
AI_HOST=0.0.0.0

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# AWS S3 / Image Storage (인프라 ap-northeast-2 Seoul)
AWS_REGION=ap-northeast-2
# 로컬: SSO/aws-vault 권장 · 배포: ECS task role(장기키 미사용). 아래는 로컬 더미.
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
S3_IMAGES_BUCKET=helpbee-images-dev

# Authentication (apps/api config/env.ts가 길이 fail-fast 검증)
JWT_SECRET=dev_only_change_me_jwt_secret_0000000000000000000000000000000000000  # >=64 chars
REFRESH_TOKEN_PEPPER=dev_only_change_me_refresh_pepper_000000  # >=32 chars (HMAC, argon2 아님)

# AI service (apps/api -> apps/ai)
AI_BASE_URL=http://localhost:8000
AI_INTERNAL_HMAC_SECRET=dev_only_change_me_internal_hmac_secret_0  # >=32 chars (D10 내부 인증)
# apps/ai가 image_url을 fetch할 때 허용할 host(SSRF allowlist, 쉼표구분, 서브도메인 포함)
IMAGE_ALLOWLIST_HOSTS=s3.ap-northeast-2.amazonaws.com,cdn.helpbee.kr
IMAGE_FETCH_ALLOW_HTTP=false

# Email (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_email_password

# Service URLs
WEB_URL=http://localhost:3000
API_URL=http://localhost:3001
AI_URL=http://localhost:8000

# Feature Flags
ENABLE_AI_ANALYSIS=true
ENABLE_EMAIL_NOTIFICATIONS=false
