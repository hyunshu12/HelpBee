{
  "name": "@helpbee/database",
  "version": "0.1.0",
  "private": true,
  "description": "Database schema, migrations, queries, and seeds (Drizzle ORM + postgres-js)",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "generate": "drizzle-kit generate:pg",
    "migrate": "tsx src/migrate.ts",
    "push": "drizzle-kit push:pg",
    "check": "drizzle-kit check:pg",
    "studio": "drizzle-kit studio",
    "seed:dev": "tsx src/seeds/dev.ts",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "argon2": "^0.31.2",
    "drizzle-orm": "^0.29.5",
    "postgres": "^3.4.0"
  },
  "devDependencies": {
    "@helpbee/config": "workspace:*",
    "@types/node": "^20.0.0",
    "drizzle-kit": "^0.20.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  }
}
